# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Models are selected by tier (see config.py). Override a tier:
#   MODEL_REASONING=gemini-3.1-pro-preview
#   MODEL_FAST=gemini-3.8-flash
#   MODEL_LITE=gemini-3.1-flash-lite
# Or pin a single agent (AGENT_KEY from agents/*.py):
#   MODEL_OVERRIDE_ORCHESTRATOR=gemini-2.5-pro
#   MODEL_OVERRIDE_FINANCIAL_MANAGER=gemini-2.5-pro

# ── Vertex AI Search ─────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_DATASTORE_ID=your-vertex-datastore-id
VERTEX_LOCATION=global

# ── Gmail OAuth (per-user "Connect Gmail") ───────────────────────────────────
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
GOOGLE_TOKEN_PATH=tokens/gmail_token.json

# ── Slack ────────────────────────────────────────────────────────────────────
# Global bot token: fallback for signed-in users only, never for trial guests
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Per-user "Connect Slack" OAuth app (api.slack.com)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-service-url/oauth/slack/callback

# ── Storage ──────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
OUTPUT_BUCKET=pm-agent-output
GMAIL_TOKEN_BUCKET=pm-agent-gmail-tokens

# ── Server & auth ────────────────────────────────────────────────────────────
PORT=8000
SECRET_KEY=change-me-in-production
COOKIE_SECURE=true
USERS_JSON=users.json
LOG_LEVEL=INFO

# ── Trial mode ───────────────────────────────────────────────────────────────
TRIAL_SESSION_HOURS=24
TRIAL_MAX_GENERATIONS=3
TRIAL_DAILY_CAP=40
TRIAL_LEADS_SHEET_ID=
PURGE_SECRET=change-me
# GUEST_GEMINI_MODEL / GUEST_MAX_OUTPUT_TOKENS default to the fast tier and the
# model's output ceiling — a lower cap makes Gemini 3 tool calls fail as MALFORMED.
